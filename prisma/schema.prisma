generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: migraciones necesitan conexión DIRECTA (sin -pooler)
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  WRITER
}

enum ArticleStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
}

enum TagType {
  TEAM
  PLAYER
  TOPIC
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(WRITER)
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[] @relation("ArticleAuthor")
  authoredBy   Author?
}

model Author {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  bio        String?
  avatarUrl  String?
  column     String?
  role       String?
  featured   Boolean   @default(false)
  sortOrder  Int       @default(0)
  facebook   String?
  twitter    String?
  tiktok     String?
  instagram  String?
  userId     String?   @unique
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  articles   Article[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  color       String    @default("#C8102E")
  sortOrder   Int       @default(0)
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      TagType      @default(TOPIC)
  articles  ArticleTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  contentJson   Json
  contentHtml   String        @db.Text
  status        ArticleStatus @default(DRAFT)
  featured      Boolean       @default(false)
  heroImageUrl  String?
  heroAlt       String?
  heroCredit    String?
  heroCaption   String?
  heroFocalX    Float         @default(50)
  heroFocalY    Float         @default(50)
  youtubeId     String?
  viewCount     Int           @default(0)
  publishedAt   DateTime?
  scheduledFor  DateTime?
  seoTitle      String?
  seoDescription String?
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  authorId      String
  author        Author        @relation(fields: [authorId], references: [id])
  userId        String?
  user          User?         @relation("ArticleAuthor", fields: [userId], references: [id], onDelete: SetNull)
  tags          ArticleTag[]
  comments      Comment[]
  revisions     ArticleRevision[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  alt       String?
  width     Int?
  height    Int?
  mimeType  String?
  createdAt DateTime @default(now())
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Comment {
  id        String        @id @default(cuid())
  articleId String
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  name      String
  body      String        @db.Text
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([articleId, status])
}

model ArticleRevision {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title       String
  excerpt     String?
  contentJson Json
  contentHtml String   @db.Text
  editorName  String?
  createdAt   DateTime @default(now())

  @@index([articleId, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
